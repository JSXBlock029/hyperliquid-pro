# Copy to .env. Never commit the real file.

# --- Hyperliquid accounts -------------------------------------------------------
# Main wallet address (public). Used to read balances and positions.
HYPERLIQUID_MAIN_WALLET=
# Optional API (agent) wallet address and its key. Prefer an API wallet over your main key:
# it can trade but cannot withdraw.
HYPERLIQUID_API_WALLET=
HYPERLIQUID_API_PRIVATE_KEY=
HYPERLIQUID_MAIN_PRIVATE_KEY=

# --- Server ----------------------------------------------------------------------
PORT=3000
# Binds to localhost by default. Only set 0.0.0.0 if you also set HLPRO_API_TOKEN.
SERVER_HOST=127.0.0.1
# Required for state-changing requests (orders, closes, scalp toggle, TradingView webhook)
# that come from any address other than this machine. Send as X-API-Token or ?token=
HLPRO_API_TOKEN=

# --- Scalp stack (paper trading unless SCALP_LIVE=true AND toggled on in the UI) ------
SCALP_ENABLED=true
SCALP_LIVE=false
SCALP_SYMBOLS=BTC,ETH,SOL
SCALP_SIGNAL=gigafade
SCALP_USE_AGENT=true
SCALP_CAPITAL_USD=200
SCALP_LEVERAGE=5
SCALP_MAX_CONCURRENT=2
SCALP_MAX_DAILY_LOSS=20

# --- LLM judging (optional; local Ollama is the default provider) -----------------------
OLLAMA_HOST=127.0.0.1:11434
SCALP_MODEL=qwen2.5:7b-instruct
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Other optional ----------------------------------------------------------------
COINGECKO_API_KEY=
TG_BOT_TOKEN=
TG_CHAT_ID=
